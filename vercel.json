{
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/reminder-checkout",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/reminder-overtime",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/auto-end-overtime",
      "schedule": "20 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
